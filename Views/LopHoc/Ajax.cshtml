@model AjaxSearchViewModel
@{
    ViewData["Title"] = "Bài tập AJAX";
}

<div class="mb-4">
    <span class="badge text-bg-primary mb-2">Phần C · Bài 11 - Bài 15</span>
    <h1 class="h2 fw-bold">AJAX với ASP.NET Core MVC</h1>
    <p class="text-secondary">Thao tác tìm kiếm gọi Controller mà không tải lại trang; truy vấn dữ liệu đi qua Repository.</p>
</div>

<div id="ajaxEndpoints"
     data-xin-chao-url="@Url.Action("XinChao", "LopHoc")"
     data-tu-khoa-url="@Url.Action("TimKiemTuKhoa", "LopHoc")"
     data-tim-kiem-url="@Url.Action("TimKiemThietBi", "LopHoc")">
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5">Bài 11 · Gọi Controller bằng AJAX</h2>
                    <p class="text-secondary">Gọi action XinChao() và hiển thị nội dung trả về.</p>
                    <button id="goiXinChao" class="btn btn-primary" type="button">Gọi XinChao()</button>
                    <div id="ketQuaXinChao" class="alert alert-info mt-3 mb-0 d-none" role="status" aria-live="polite"></div>
                </div>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5">Bài 12 · Gửi từ khóa lên Controller</h2>
                    <label for="tuKhoaController" class="form-label">Từ khóa</label>
                    <div class="input-group">
                        <input id="tuKhoaController" class="form-control" type="text" placeholder="Nhập từ khóa..." />
                        <button id="guiTuKhoaController" class="btn btn-outline-primary" type="button">Gửi</button>
                    </div>
                    <div id="ketQuaTuKhoaController" class="mt-3 text-secondary" aria-live="polite">Chưa gửi từ khóa.</div>
                </div>
            </section>
        </div>
    </div>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5">Bài 13 - Bài 15 · Tìm kiếm thiết bị bằng Repository</h2>
            <p class="text-secondary">Bài 13: nút tìm kiếm. Bài 14: tìm tự động khi nhập. Bài 15: lọc đồng thời theo loại và tên.</p>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="loaiThietBiAjax" class="form-label">Loại thiết bị (Bài 15)</label>
                    <select id="loaiThietBiAjax" class="form-select">
                        <option value="">Tất cả loại</option>
                        @foreach (var loai in Model.LoaiThietBis)
                        {
                            <option value="@loai.Id">@loai.TenLoai</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="tuKhoaThietBiAjax" class="form-label">Tên thiết bị (Bài 13 - Bài 14)</label>
                    <input id="tuKhoaThietBiAjax" class="form-control" type="search" placeholder="Nhập tên thiết bị..." autocomplete="off" />
                </div>
                <div class="col-md-3 d-grid">
                    <button id="timKiemThietBiAjax" class="btn btn-primary" type="button">Tìm kiếm (Bài 13)</button>
                </div>
            </div>
            <div id="trangThaiTimKiemAjax" class="small text-secondary mt-3" aria-live="polite"></div>
            <div id="ketQuaThietBiAjax" class="mt-3">
                <partial name="_DanhSachThietBiPartial" model="Model.ThietBis" />
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/ajax-part-c.js" asp-append-version="true"></script>
}
