@{
    ViewData["Title"] = "Bài tập JavaScript";
}

<div class="mb-4">
    <span class="badge text-bg-primary mb-2">Phần A · Bài 1 - Bài 5</span>
    <h1 class="h2 fw-bold">JavaScript cơ bản</h1>
    <p class="text-secondary">Nhập thông tin thiết bị và thực hành xử lý sự kiện phía trình duyệt.</p>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Thông tin thiết bị</h2>
                <div class="mb-3">
                    <label for="tenThietBiJs" class="form-label">Tên thiết bị</label>
                    <input id="tenThietBiJs" class="form-control" type="text" placeholder="Ví dụ: Loa Bluetooth" />
                </div>
                <div class="mb-3">
                    <label for="donGiaJs" class="form-label">Đơn giá (₫)</label>
                    <input id="donGiaJs" class="form-control" type="number" min="0" step="1000" placeholder="0" />
                </div>
                <div class="mb-3">
                    <label for="soLuongJs" class="form-label">Số lượng</label>
                    <input id="soLuongJs" class="form-control" type="number" step="1" placeholder="0" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button id="hienThiThietBi" class="btn btn-primary" type="button">Hiển thị</button>
                    <button id="tinhThanhTien" class="btn btn-outline-primary" type="button">Tính thành tiền</button>
                    <button id="kiemTraSoLuong" class="btn btn-outline-secondary" type="button">Kiểm tra số lượng</button>
                </div>
                <div id="ketQuaJs" class="alert alert-info mt-3 mb-0 d-none" role="status" aria-live="polite"></div>
            </div>
        </section>
    </div>

    <div class="col-lg-7">
        <section class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                    <h2 class="h5 mb-0">Khu vực thông tin (Bài 4)</h2>
                    <button id="toggleThongTin" class="btn btn-sm btn-outline-secondary" type="button">Ẩn thông tin</button>
                </div>
                <div id="vungThongTin" class="rounded border bg-light p-3">
                    <p class="mb-1"><strong>Tên:</strong> <span id="tenHienThi">Chưa có dữ liệu</span></p>
                    <p class="mb-1"><strong>Đơn giá:</strong> <span id="giaHienThi">Chưa có dữ liệu</span></p>
                    <p class="mb-0"><strong>Số lượng:</strong> <span id="soLuongHienThi">Chưa có dữ liệu</span></p>
                </div>
                <hr />
                <h3 class="h6">Bài 5 · Xác nhận trước khi xóa</h3>
                <p class="small text-secondary">Nút xóa chỉ xóa dữ liệu đang hiển thị sau khi xác nhận.</p>
                <button id="xoaThietBi" class="btn btn-outline-danger" type="button">Xóa thiết bị</button>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/js-part-a.js" asp-append-version="true"></script>
}
