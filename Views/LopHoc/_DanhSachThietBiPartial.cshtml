@model IReadOnlyList<ThietBi>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mb-0" role="status">Không tìm thấy thiết bị phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Tên thiết bị</th>
                    <th scope="col">Loại</th>
                    <th scope="col" class="text-end">Đơn giá</th>
                    <th scope="col" class="text-end">Số lượng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var thietBi in Model)
                {
                    <tr>
                        <td>@thietBi.Id</td>
                        <td>@thietBi.TenThietBi</td>
                        <td>@thietBi.LoaiThietBi?.TenLoai</td>
                        <td class="text-end">@thietBi.DonGia.ToString("N0") ₫</td>
                        <td class="text-end">@thietBi.SoLuong</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
