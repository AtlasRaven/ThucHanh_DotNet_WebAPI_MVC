@{
    ViewData["Title"] = "Trang chủ bài tập";
}

<div class="mb-4">
    <span class="badge text-bg-primary mb-2">ASP.NET Core MVC</span>
    <h1 class="display-6 fw-bold">Thực hành JavaScript, jQuery và AJAX</h1>
    <p class="text-secondary mb-0">Chọn một phần để xem các bài tập và chạy thử trực tiếp.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <article class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-primary fw-semibold mb-2">Bài 1 - Bài 5</div>
                <h2 class="h4">JavaScript</h2>
                <p class="text-secondary">Nhập thông tin, tính thành tiền, kiểm tra số lượng, ẩn hiện và xác nhận xóa.</p>
                <a class="btn btn-outline-primary" asp-action="JavaScript">Mở phần A</a>
            </div>
        </article>
    </div>
    <div class="col-md-4">
        <article class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-primary fw-semibold mb-2">Bài 6 - Bài 10</div>
                <h2 class="h4">jQuery</h2>
                <p class="text-secondary">Đọc dữ liệu form, cập nhật nội dung, lọc danh sách tĩnh và kiểm tra form.</p>
                <a class="btn btn-outline-primary" asp-action="JQuery">Mở phần B</a>
            </div>
        </article>
    </div>
    <div class="col-md-4">
        <article class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-primary fw-semibold mb-2">Bài 11 - Bài 15</div>
                <h2 class="h4">AJAX + Repository</h2>
                <p class="text-secondary">Gọi Controller không tải lại trang, tìm kiếm và lọc thiết bị từ cơ sở dữ liệu.</p>
                <a class="btn btn-outline-primary" asp-action="Ajax">Mở phần C</a>
            </div>
        </article>
    </div>
</div>
