<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản lý thiết bị</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="ThietBi" asp-action="Index">Quản lý thiết bị</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation"
                    aria-controls="navigation" aria-expanded="false" aria-label="Mở điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navigation">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="ThietBi" asp-action="Index">Danh sách thiết bị</a>
                    <a class="nav-link" asp-controller="ThietBi" asp-action="Create">Thêm thiết bị</a>
                    <a class="nav-link" asp-controller="ThietBi" asp-action="ThongKe">Thống kê</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 py-lg-5">
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-3">
        <div class="container text-muted small">ASP.NET Core MVC 6 · Repository Pattern · Entity Framework Core</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
