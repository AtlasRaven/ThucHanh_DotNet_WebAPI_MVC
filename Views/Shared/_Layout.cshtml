<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Thực hành JavaScript, jQuery &amp; AJAX</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="LopHoc" asp-action="Index">Thực hành Web</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="LopHoc" asp-action="JavaScript">Phần A - JavaScript</a>
                    <a class="nav-link" asp-controller="LopHoc" asp-action="JQuery">Phần B - jQuery</a>
                    <a class="nav-link" asp-controller="LopHoc" asp-action="Ajax">Phần C - AJAX</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 py-lg-5">
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-3">
        <div class="container text-muted small">Bài tập thực hành ASP.NET Core MVC · Repository · EF Core</div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
