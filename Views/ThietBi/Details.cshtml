@model ThietBi
@{
    ViewData["Title"] = "Chi tiết thiết bị";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge text-bg-primary mb-2">Bài 2 · Chi tiết</span>
        <h1 class="h2 fw-bold mb-0">Chi tiết thiết bị</h1>
    </div>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ThietBiId">Chỉnh sửa</a>
</div>

<section class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã thiết bị</dt>
            <dd class="col-sm-9">@Model.ThietBiId</dd>
            <dt class="col-sm-3">Tên thiết bị</dt>
            <dd class="col-sm-9">@Model.TenThietBi</dd>
            <dt class="col-sm-3">Loại thiết bị</dt>
            <dd class="col-sm-9">@Model.LoaiThietBi?.TenLoai</dd>
            <dt class="col-sm-3">Đơn giá</dt>
            <dd class="col-sm-9">@Model.DonGia.ToString("N0") ₫</dd>
            <dt class="col-sm-3">Số lượng</dt>
            <dd class="col-sm-9">@Model.SoLuong</dd>
            <dt class="col-sm-3">Ngày nhập</dt>
            <dd class="col-sm-9">@Model.NgayNhap.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Giá trị tồn kho</dt>
            <dd class="col-sm-9">@((Model.DonGia * Model.SoLuong).ToString("N0")) ₫</dd>
        </dl>
        <a class="btn btn-outline-secondary mt-4" asp-action="Index">Quay lại danh sách</a>
    </div>
</section>
