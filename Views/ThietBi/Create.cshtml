@model ThietBi
@{
    ViewData["Title"] = "Thêm thiết bị";
    var loaiThietBis = ViewData["LoaiThietBis"] as IReadOnlyList<LoaiThietBi>
        ?? Array.Empty<LoaiThietBi>();
}

<div class="mb-4">
    <span class="badge text-bg-primary mb-2">Bài 3 · Thêm mới</span>
    <h1 class="h2 fw-bold">Thêm thiết bị</h1>
</div>

<section class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_ThietBiFormFields" model="Model" view-data="ViewData" />
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">Lưu thiết bị</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
