@model ThietBi
@{
    var loaiThietBis = ViewData["LoaiThietBis"] as IReadOnlyList<LoaiThietBi>
        ?? Array.Empty<LoaiThietBi>();
}

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="TenThietBi" class="form-label"></label>
        <input asp-for="TenThietBi" class="form-control" />
        <span asp-validation-for="TenThietBi" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LoaiThietBiId" class="form-label"></label>
        <select asp-for="LoaiThietBiId" class="form-select">
            <option value="0">-- Chọn loại thiết bị --</option>
            @foreach (var loai in loaiThietBis)
            {
                <option value="@loai.LoaiThietBiId">@loai.TenLoai</option>
            }
        </select>
        <span asp-validation-for="LoaiThietBiId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DonGia" class="form-label"></label>
        <div class="input-group">
            <input asp-for="DonGia" class="form-control" type="number" min="0.01" step="0.01" />
            <span class="input-group-text">₫</span>
        </div>
        <span asp-validation-for="DonGia" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SoLuong" class="form-label"></label>
        <input asp-for="SoLuong" class="form-control" type="number" min="0" step="1" />
        <span asp-validation-for="SoLuong" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="NgayNhap" class="form-label"></label>
        <input asp-for="NgayNhap" class="form-control" type="date" />
        <span asp-validation-for="NgayNhap" class="text-danger"></span>
    </div>
</div>
